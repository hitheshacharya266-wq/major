# ==========================================
# ServiceHub Environment Variables Template
# Copy this file to .env.local for local development.
# ==========================================

# Cloudinary Configuration (for Provider Portfolio Images)
# Sign up at https://cloudinary.com (Free Tier)
# In Settings -> Upload -> Add upload preset -> Signing mode: Unsigned
VITE_CLOUDINARY_CLOUD_NAME=your_cloud_name_here
VITE_CLOUDINARY_UPLOAD_PRESET=servicehub_portfolio
